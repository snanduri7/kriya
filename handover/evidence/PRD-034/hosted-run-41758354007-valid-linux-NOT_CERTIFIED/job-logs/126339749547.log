2026-11-04T04:22:24.3649659Z         body = ("import subprocess, sys, time\n\n\ndef test_stalls():\n    print('INNER-STARTED', flush=True)\n"
2026-11-04T04:22:24.3650204Z                 f"    subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(120)', {grandchild!r}])  # a grandchild that outlives a kill of only the inner pytest, its argv names it\n"
2026-11-04T04:22:24.3650314Z                 "    time.sleep(120)\n")
2026-11-04T04:22:24.3650471Z         with pytest.raises(pytest.fail.Exception) as caught:
