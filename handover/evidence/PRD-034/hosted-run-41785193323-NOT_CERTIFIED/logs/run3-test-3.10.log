2026-11-04T08:59:49.5177471Z         conn.commit()
2026-11-04T08:59:49.5177664Z         conn.execute("PRAGMA cache_size=10")
2026-11-04T08:59:49.5178019Z         conn.executemany("INSERT INTO runs VALUES (?, ?)", ((f"r{i}", "x" * 2000) for i in range(300)))
2026-11-04T08:59:49.5178476Z         # simulate the crash: leave the journal hot by killing the connection without rollback
2026-11-04T08:59:49.5179032Z         script = (f"import sqlite3; c = sqlite3.connect({src!r}); c.execute('PRAGMA journal_mode=DELETE'); c.execute('PRAGMA cache_size=10');"
2026-11-04T08:59:49.5179635Z                   " c.executemany('INSERT INTO runs VALUES (?, ?)', ((f'h{i}', 'y' * 2000) for i in range(300))); import os; os._exit(0)")
2026-11-04T08:59:49.5180025Z         conn.rollback()
2026-11-04T08:59:49.5180211Z         conn.close()
2026-11-04T08:59:49.5180447Z         subprocess.run([sys.executable, "-c", script], check=True)
2026-11-04T08:59:49.5180739Z         assert os.path.exists(src + "-journal")
2026-11-04T08:59:49.5181000Z         with pytest.raises(SnapshotError) as excinfo:
2026-11-04T08:59:49.5181335Z >           acquire_snapshot(src, str(tmp_path / "s" / "kup-snapshots"))
