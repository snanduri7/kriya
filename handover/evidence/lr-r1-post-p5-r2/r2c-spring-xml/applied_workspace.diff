     }
+
+    @Test
+    void hasPet_returnsTrueWhenPetExists() {
+        // Given
+        Owner owner = new Owner();
+        Pet pet = new Pet();
+        pet.setName("Fluffy");
+        owner.addPet(pet);
+
+        // When & Then
+        assertThat(owner.hasPet("Fluffy")).isTrue();
+        assertThat(owner.hasPet("fluffy")).isTrue();
+        assertThat(owner.hasPet("FLUFFY")).isTrue();
+    }
+
+    @Test
+    void hasPet_returnsFalseWhenPetDoesNotExist() {
+        // Given
+        Owner owner = new Owner();
+        Pet pet = new Pet();
+        pet.setName("Fluffy");
+        owner.addPet(pet);
+
+        // When & Then
+        assertThat(owner.hasPet("Buddy")).isFalse();
+        assertThat(owner.hasPet("Max")).isFalse();
+    }
 }
