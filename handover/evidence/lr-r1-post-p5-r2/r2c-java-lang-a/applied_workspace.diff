+    public static boolean containsOnly(final String str, final String... set) {
+        if (isEmpty(str, set)) {
+            return true;
+        }
+        final CharSet chars = CharSet.getInstance(set);
+        for (final char c : str.toCharArray()) {
+            if (!chars.contains(c)) {
+                return false;
+            }
+        }
+        return true;
+    }
