+    void testContainsOnly_StringString() {
+        // Test null string
+        assertTrue(CharSetUtils.containsOnly(null, (String) null));
+        assertTrue(CharSetUtils.containsOnly(null, ""));
+
+        // Test empty string
+        assertTrue(CharSetUtils.containsOnly("", (String) null));
+        assertTrue(CharSetUtils.containsOnly("", ""));
+        assertTrue(CharSetUtils.containsOnly("", "a-e"));
+
+        // Test non-empty string with null set
+        assertFalse(CharSetUtils.containsOnly("hello", (String) null));
+        assertFalse(CharSetUtils.containsOnly("hello", ""));
+
+        // Test positive cases
+        assertTrue(CharSetUtils.containsOnly("hello", "a-z"));
+        assertTrue(CharSetUtils.containsOnly("abc", "a-c"));
+        assertTrue(CharSetUtils.containsOnly("123", "0-9"));
+
+        // Test negative cases
+        assertFalse(CharSetUtils.containsOnly("hello", "a-d"));
+        assertFalse(CharSetUtils.containsOnly("abc", "a-b"));
+        assertFalse(CharSetUtils.containsOnly("123", "4-9"));
+    }
+
