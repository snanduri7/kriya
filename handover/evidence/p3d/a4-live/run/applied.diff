+    /**
+     * Returns {@code true} if any of the given option names is present in this command line.
+     *
+     * @param optNames the option names to check
+     * @return {@code true} if any of the given option names is present, {@code false} otherwise
+     */
+    public boolean hasAnyOption(final String... optNames) {
+        if (optNames == null || optNames.length == 0) {
+            return false;
+        }
+        for (final String optName : optNames) {
+            if (hasOption(optName)) {
+                return true;
+            }
+        }
+        return false;
+    }
