# Kriya Memory and cached indexes - anchored to repo root (leading slash) so
# this doesn't also match kriya/memory/, the real source package (vector
# store, embedding client) - an unanchored "memory/" matches a directory of
# that name at ANY depth, which silently kept kriya/memory/ out of git
# entirely, undetected until a genuinely fresh checkout (CI) failed with
# ModuleNotFoundError: No module named 'kriya.memory'.
/memory/
.system_generated/
*.log

# Kriya's own runtime working directory when dogfooding kriya generate/
# analyze/prompt against this repo itself - checkpoints, the sandboxed
# worktree, and prompt generate's auto-saved .kriya/last_prompt.md. Found
# missing while adding last_prompt.md: checkpoint.py/worktree.py already
# wrote here with no corresponding .gitignore entry, so any real dogfooding
# run showed these as untracked files.
/.kriya/

# SQLite databases and temp files
*.db
*.db-wal
*.db-shm
/logs/

# Scratch generation folders
scratch_generate/

# Eval harness batch output (workspaces, logs, traces.db, summaries) - scratch,
# regenerated by spikes/eval_harness/run_harness.py on every run.
/spikes/eval_harness/runs/
