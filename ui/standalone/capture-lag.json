 {
  "name": "event_loop_lag",
  "js": "(()=>{clearInterval(window.__t);const pct=(a,p)=>a.length?a.slice().sort((x,y)=>x-y)[Math.min(a.length-1,Math.floor(a.length*p))]:null;const seg=(s,e)=>{const a=window.__lag.slice(s,e);return {samples:a.length,median:pct(a,.5),p95:pct(a,.95),p99:pct(a,.99),max:a.length?Math.max(...a):null,over100ms:a.filter(x=>x>100).length}};const m=Object.fromEntries(window.__marks);const out={all:seg(0,window.__lag.length),idle:seg(m.idle_begin,m.open_folder_begin),open_folder:seg(m.open_folder_begin,m.open_folder_end),navigation:seg(m.open_folder_end,m.navigation_end),active_run:seg(m.run_begin,m.run_end),after_run:seg(m.run_end,m.after_end)};return out})()",
  "wait": 100
 }
