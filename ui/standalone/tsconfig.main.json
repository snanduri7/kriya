{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "outDir": "dist/main",
    "rootDir": "src/main",
    "noEmit": false,
    "sourceMap": true,
    "jsx": "preserve"
  },
  "include": [
    "src/main"
  ],
  "exclude": [
    "src/main/preload.ts"
  ]
}
