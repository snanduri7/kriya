{
  "name": "@kriya-ui/kup",
  "private": true,
  "version": "0.0.1",
  "description": "Kriya UI Protocol (KUP) v1: JSON Schema, generated TypeScript types, host contract schema. Phase B. Phase A holds only the placeholder.",
  "type": "module",
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "quicktype-core": "26.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "java:check": "node scripts/java_check.mjs",
    "report": "node tools/run_report.mjs",
    "compare": "node tools/run_compare.mjs",
    "evidence-check": "node tools/evidence_check.mjs"
  },
  "main": "src/index.ts",
  "types": "src/index.ts"
}
