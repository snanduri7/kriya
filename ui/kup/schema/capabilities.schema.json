{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kriya.local/kup/v1/capabilities.schema.json",
  "title": "Capabilities",
  "description": "data of `kriya traces --capabilities --json` (P-25). Establishes KUP compatibility; package identity alone never does (P-27).",
  "type": "object",
  "required": ["kup_versions", "operations", "identity", "limits", "features"],
  "properties": {
    "kup_versions": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
    "operations": { "type": "array", "items": { "type": "string" } },
    "identity": {
      "type": "object",
      "properties": {
        "kriya_version": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "build_provenance": { "type": ["string", "null"], "description": "As `kriya version --json` reports it (KRIYA-VERSION-001)." }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "list_default": { "type": "integer" },
        "list_max": { "type": "integer" },
        "max_response_bytes": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "features": { "type": "object", "additionalProperties": true, "description": "Feature availability flags; values are literal data, never assumed." }
  },
  "additionalProperties": true
}
