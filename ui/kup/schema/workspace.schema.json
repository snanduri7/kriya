{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kriya.local/kup/v1/workspace.schema.json",
  "title": "WorkspaceStatus",
  "description": "data of `kriya runs status --workspace PATH --json --kup-version 1`: an envelope around the existing recovery assessment; status and semantic exit codes preserved (P-25, P-27). Belongs to the selected workspace at observation time, never to a selected trace row (P-22).",
  "type": "object",
  "required": ["workspace", "run_active", "status", "exit_code", "assessment"],
  "properties": {
    "workspace": { "type": "string" },
    "run_active": { "type": ["boolean", "null"], "description": "RUN_ACTIVE observation; null = unknown." },
    "status": { "type": ["string", "null"], "description": "The existing recovery assessment status, verbatim." },
    "exit_code": { "type": ["integer", "null"], "description": "The semantic exit code the non-KUP command would have returned." },
    "assessment": { "type": ["object", "array", "string", "number", "boolean", "null"], "description": "RecoveryAssessment.to_dict() verbatim (kriya/control/recovery.py)." }
  },
  "additionalProperties": true,
  "$defs": {
    "WorkspaceDescribe": {
      "description": "data of `workspace.describe` (GUI M5): the read-only facts Kriya reports about a folder the desktop host picked. Nothing here classifies the folder as greenfield or brownfield; absent facts are null (the host shows Not recorded), never inferred.",
      "type": "object",
      "required": ["workspace", "requested", "name", "identity", "checkout", "recovery", "kriya_directory_present", "configuration", "state"],
      "properties": {
        "workspace": { "type": "string", "description": "Kriya's canonical spelling of the folder (control-plane identity input)." },
        "requested": { "type": "string", "description": "The path as picked." },
        "name": { "type": "string" },
        "identity": { "type": "string", "description": "sha256 workspace identity Kriya records in run manifests." },
        "checkout": {
          "type": "object",
          "required": ["state", "root", "head", "branch", "detached", "dirty", "changed_entries", "changed_truncated", "reason"],
          "properties": {
            "state": { "type": "string", "enum": ["checkout_root", "inside_repository", "not_a_repository", "git_unavailable"] },
            "root": { "type": ["string", "null"] },
            "head": { "type": ["string", "null"], "description": "Commit Git reports for HEAD; null when unborn or not a checkout root." },
            "branch": { "type": ["string", "null"] },
            "detached": { "type": ["boolean", "null"] },
            "dirty": { "type": ["boolean", "null"], "description": "Tracked changes or untracked files per `git status`; null when Git did not report." },
            "changed_entries": { "type": ["integer", "null"], "description": "Upper bound on changed paths (a rename counts its source too), capped at 1000." },
            "changed_truncated": { "type": "boolean" },
            "reason": { "type": ["string", "null"], "description": "Why a fact is missing, when Git said." }
          },
          "additionalProperties": true
        },
        "recovery": {
          "type": "object",
          "required": ["status", "run_active"],
          "properties": { "status": { "type": "string" }, "run_active": { "type": "boolean" } },
          "additionalProperties": true
        },
        "kriya_directory_present": { "type": "boolean" },
        "configuration": {
          "type": "object",
          "required": ["file_in_workspace", "note"],
          "properties": { "file_in_workspace": { "type": "boolean" }, "note": { "type": "string" } },
          "additionalProperties": true
        },
        "state": {
          "type": "object",
          "required": ["directory", "source", "trace_database_present"],
          "properties": {
            "directory": { "type": "string" },
            "source": { "type": "string", "enum": ["env", "config", "default"] },
            "trace_database_present": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ExecutionPreflight": {
      "description": "data of `execution.preflight` (GUI M6): what a run in this folder would be, resolved by Kriya exactly as a terminal `kriya generate` run there would be. The host displays it and decides nothing from it; the launched process re-resolves it and refuses on any blocker.",
      "type": "object",
      "required": ["ready", "blockers", "workspace", "configuration", "state", "model", "recovery", "interaction", "toolchains"],
      "properties": {
        "ready": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
            "additionalProperties": true
          }
        },
        "workspace": {
          "type": "object",
          "required": ["path", "identity", "name"],
          "properties": { "path": { "type": "string" }, "identity": { "type": "string" }, "name": { "type": "string" } },
          "additionalProperties": true
        },
        "configuration": {
          "type": "object",
          "required": ["status", "source", "file", "directory", "discovery", "authority", "fingerprint"],
          "properties": {
            "status": { "type": "string", "enum": ["loaded", "refused", "failed"] },
            "source": { "type": "string", "description": "Kriya's ConfigSource value for the user layer (packaged_default when no file was found)." },
            "file": { "type": ["string", "null"] },
            "directory": { "type": "string", "description": "The directory configuration was discovered from (the folder itself)." },
            "discovery": { "type": "string" },
            "fingerprint": { "type": ["string", "null"], "description": "Digest of the effective configuration (the resume checkpoint's own fingerprint); null when it did not load." },
            "authority": {
              "type": "object",
              "required": ["status", "fields"],
              "properties": {
                "status": { "type": "string", "enum": ["no_findings", "approved", "refused", "failed"] },
                "fields": { "type": "array", "items": {} }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "state": {
          "type": "object",
          "required": ["directory", "source", "cockpit_directory", "observable_by_cockpit"],
          "properties": {
            "directory": { "type": ["string", "null"] },
            "source": { "type": ["string", "null"], "enum": ["env", "config", "default", null] },
            "cockpit_directory": { "type": ["string", "null"] },
            "observable_by_cockpit": { "type": ["boolean", "null"] }
          },
          "additionalProperties": true
        },
        "model": {
          "type": ["object", "null"],
          "required": ["provider", "model", "endpoint", "context_window", "fallback_chain", "role_overrides"],
          "properties": {
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "endpoint": { "type": "string" },
            "context_window": { "type": "integer" },
            "fallback_chain": { "type": "array", "items": { "type": "string" } },
            "role_overrides": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "recovery": {
          "type": "object",
          "required": ["status", "run_active"],
          "properties": { "status": { "type": "string" }, "run_active": { "type": "boolean" } },
          "additionalProperties": true
        },
        "toolchains": {
          "type": "object",
          "required": ["tools", "note"],
          "properties": {
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["tool", "available", "path"],
                "properties": { "tool": { "type": "string" }, "available": { "type": "boolean" }, "path": { "type": ["string", "null"] } },
                "additionalProperties": true
              }
            },
            "note": { "type": "string" }
          },
          "additionalProperties": true
        },
        "interaction": {
          "type": "object",
          "required": ["approvals", "knowledge_policy", "note"],
          "properties": { "approvals": { "type": "string", "enum": ["change_review", "configured_mode", "unknown", "unavailable"], "description": "change_review: a change is held for the person's review (human-in-the-loop). configured_mode: the resolved configuration selects another autonomy mode (shown, never changed by the app). unknown: the configuration could not be resolved." }, "autonomy_mode": { "type": ["string", "null"], "description": "The autonomy mode of the resolved configuration, verbatim." }, "knowledge_policy": { "type": "string" }, "note": { "type": "string" } },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "WorkspaceCreate": {
      "description": "data of `workspace.create` (end-user experience): ONE new empty project folder was created by Kriya. Nothing else was written.",
      "type": "object",
      "required": ["workspace", "name", "parent", "identity", "created", "git_initialized", "note"],
      "properties": {
        "workspace": { "type": "string" }, "name": { "type": "string" }, "parent": { "type": "string" }, "identity": { "type": "string" },
        "created": { "const": true }, "git_initialized": { "const": false }, "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ConfigurationApprovalStatus": {
      "description": "data of `configuration.approval_status`: which operator-controlled settings of a folder need an approval and whether a current approval covers them, exactly as `kriya authority inspect` reports it. Only the NAMES of the settings are carried; no configuration value is ever sent.",
      "type": "object",
      "required": ["workspace", "identity", "status", "reason", "required", "can_approve", "blocking_reason", "protected_fields", "fingerprint", "scope", "values_shown", "note"],
      "properties": {
        "workspace": { "type": "string" }, "identity": { "type": "string" },
        "status": { "enum": ["not_required", "required", "approved", "unavailable"], "description": "not_required: nothing in the configuration needs approval. required: a current approval does not cover it. approved: a current approval covers it. unavailable: an approval cannot be given from this application (see reason)." },
        "reason": { "type": ["string", "null"], "description": "no_approval | stale_approval | store_unreadable | trust_file_in_effect | trust_file_inside_workspace | store_inside_workspace | null" },
        "required": { "type": "boolean" }, "can_approve": { "type": "boolean" },
        "blocking_reason": { "type": ["string", "null"] },
        "protected_fields": { "type": "array", "items": { "type": "object", "required": ["field", "classification", "source"], "properties": { "field": { "type": "string" }, "classification": { "type": "string" }, "source": { "type": "string" } }, "additionalProperties": false } },
        "fingerprint": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }] },
        "scope": { "type": "string" }, "values_shown": { "const": false }, "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ConfigurationApprove": {
      "description": "data of `configuration.approve`: the approval Kriya recorded (the same artifact `kriya authority approve` writes), or already_approved when a current approval already covered the reviewed configuration and nothing was written.",
      "type": "object",
      "required": ["workspace", "identity", "outcome", "approved_fields", "approval_digest", "scope"],
      "properties": {
        "workspace": { "type": "string" }, "identity": { "type": "string" }, "outcome": { "enum": ["approved", "already_approved"] },
        "approved_fields": { "type": "array", "items": { "type": "string" } }, "approval_digest": { "type": ["string", "null"] }, "scope": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ProjectInitialize": {
      "description": "data of `project.initialize`: Kriya created its recommended configuration file in a folder that had none. It approves nothing: the protected settings it introduces need the ordinary configuration approval.",
      "type": "object",
      "required": ["workspace", "outcome", "file", "profile", "summary", "next"],
      "properties": {
        "workspace": { "type": "string" }, "outcome": { "const": "created" }, "file": { "type": "string" }, "profile": { "type": "string" },
        "summary": { "type": "object", "additionalProperties": true }, "next": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ChangeApprovalReview": {
      "description": "data of `change_approval.review`: the EXACT proposed change a review asks the person to approve, served only after Kriya re-proved it against the review's digests (per-file diff digests, candidate digest, identity). Approval-scoped: it is not the evidence store and does not depend on content_visibility. `truncated` true means the change is larger than one response can carry: the host must NOT offer approval.",
      "type": "object",
      "required": ["launch_id", "review_id", "status", "candidate_digest", "verified", "reason", "policy_note", "review_summary", "reason_truncated", "files", "truncated"],
      "properties": {
        "launch_id": { "type": "string" }, "review_id": { "type": "string" },
        "status": { "type": "string", "description": "The review's own status: PENDING, APPROVED, REJECTED or EXPIRED." },
        "candidate_digest": { "type": "string", "description": "The digest the decision must carry; the diff below is proved to be what it binds." },
        "verified": { "const": true },
        "reason": { "type": "string", "description": "The gate's reason text, verbatim (as Kriya recorded it)." },
        "policy_note": { "type": "string", "description": "The part of the reason before the automated reviewer's section (why the change was held for a human)." },
        "review_summary": { "type": ["string", "null"], "description": "The automated reviewer's report: the text after the reviewer-section delimiter, unaltered; null when the reason has no such section." },
        "reason_truncated": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "diff_sha256", "change_type", "additions", "deletions", "hunks", "truncated"],
            "properties": {
              "path": { "type": "string" }, "diff_sha256": { "type": "string" },
              "change_type": { "enum": ["added", "deleted", "modified"] },
              "additions": { "type": "integer", "minimum": 0 }, "deletions": { "type": "integer", "minimum": 0 },
              "truncated": { "type": "boolean" },
              "hunks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["header", "old_start", "old_lines", "new_start", "new_lines", "lines"],
                  "properties": {
                    "header": { "type": "string" },
                    "old_start": { "type": "integer" }, "old_lines": { "type": "integer" }, "new_start": { "type": "integer" }, "new_lines": { "type": "integer" },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["kind", "text", "old_line", "new_line"],
                        "properties": { "kind": { "enum": ["context", "add", "remove", "note"] }, "text": { "type": "string" }, "old_line": { "type": ["integer", "null"] }, "new_line": { "type": ["integer", "null"] } },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ExecutionContext": {
      "description": "data of `execution.context`: the Skills, tools and per-role model routing a run in this folder would have, from the resolved configuration and files; starts no process and touches no network. Rule text, commands, arguments, environment and credentials are never included.",
      "type": "object",
      "required": ["workspace", "available", "unavailable_reason", "authority_status", "routing", "skills", "tools", "egress"],
      "properties": {
        "workspace": { "type": "object", "required": ["path", "name", "identity"], "properties": { "path": { "type": "string" }, "name": { "type": "string" }, "identity": { "type": "string" } }, "additionalProperties": true },
        "available": { "type": "boolean" },
        "unavailable_reason": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } }, "additionalProperties": true }] },
        "authority_status": { "type": "string" },
        "routing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "provider", "model", "endpoint", "context_window", "source", "fallback"],
            "properties": {
              "role": { "type": "string" }, "provider": { "type": "string" }, "model": { "type": "string" }, "endpoint": { "type": "string" },
              "context_window": { "type": "integer" }, "source": { "enum": ["default", "override"] }, "fallback": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "skills": {
          "oneOf": [{ "type": "null" }, {
            "type": "object",
            "required": ["items", "total", "truncated", "selection", "selection_note", "management"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "description", "category", "tags", "supported_versions", "verified", "origin", "rule_count", "staged_rule_count"],
                  "properties": {
                    "name": { "type": "string" }, "description": { "type": "string" }, "category": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } },
                    "supported_versions": { "type": "string" }, "verified": { "type": "boolean" },
                    "verified_context": { "oneOf": [{ "type": "null" }, { "type": "string" }] }, "verified_at": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
                    "gap_acknowledged": { "type": "boolean" }, "origin": { "enum": ["kriya_install", "workspace_or_configured"] },
                    "rule_count": { "type": "integer" }, "has_instructions": { "type": "boolean" }, "example_count": { "type": "integer" }, "staged_rule_count": { "type": "integer" }
                  },
                  "additionalProperties": true
                }
              },
              "total": { "type": "integer" }, "truncated": { "type": "boolean" }, "selection": { "const": "automatic" }, "selection_note": { "type": "string" }, "management": { "type": "string" }
            },
            "additionalProperties": true
          }]
        },
        "tools": {
          "oneOf": [{ "type": "null" }, {
            "type": "object",
            "required": ["plugins", "mcp_servers", "health", "management", "health_note"],
            "properties": {
              "plugins": { "type": "object", "required": ["directory", "enabled"], "properties": { "directory": { "type": "string" }, "enabled": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true },
              "mcp_servers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "declared_capabilities"],
                  "properties": {
                    "name": { "type": "string" },
                    "declared_capabilities": { "type": "object", "required": ["workspace_read", "workspace_write", "network"], "properties": { "workspace_read": { "type": "boolean" }, "workspace_write": { "type": "boolean" }, "network": { "type": "string" } }, "additionalProperties": true }
                  },
                  "additionalProperties": true
                }
              },
              "health": { "const": "not_checked" }, "management": { "type": "string" }, "health_note": { "type": "string" }
            },
            "additionalProperties": true
          }]
        },
        "egress": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["policy", "web_lookup_enabled"], "properties": { "policy": { "type": "string" }, "web_lookup_enabled": { "type": "boolean" } }, "additionalProperties": true }] }
      },
      "additionalProperties": true
    },
    "ExecutionModelProbe": {
      "description": "data of `execution.model_probe`: one bounded local GET /models per distinct endpoint, made now.",
      "type": "object",
      "required": ["available", "unavailable_reason", "authority_status", "endpoints", "roles"],
      "properties": {
        "available": { "type": "boolean" },
        "unavailable_reason": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } }, "additionalProperties": true }] },
        "authority_status": { "type": "string" },
        "egress_policy": { "type": "string" },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object", "required": ["endpoint", "state", "reason", "model_count"],
            "properties": { "endpoint": { "type": "string" }, "state": { "enum": ["reachable", "unreachable", "error", "unreadable", "not_probed"] }, "reason": { "oneOf": [{ "type": "null" }, { "type": "string" }] }, "model_count": { "type": "integer" } },
            "additionalProperties": true
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object", "required": ["for", "model", "endpoint", "available", "state"],
            "properties": { "for": { "type": "string" }, "model": { "type": "string" }, "endpoint": { "type": "string" }, "available": { "oneOf": [{ "type": "null" }, { "type": "boolean" }] }, "state": { "enum": ["model_present", "model_missing", "unreachable", "error", "unreadable", "not_probed"] } },
            "additionalProperties": true
          }
        },
        "timeout_seconds": { "type": "number" }, "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "LaunchStatus": {
      "description": "data of `launch.status` (GUI M6): one desktop launch read back from durable records only (launch record, RunRecord, attempt-evidence store, workspace run lock). `liveness` is DERIVED; no outcome is ever inferred from a process exit.",
      "type": "object",
      "required": ["launch", "run_record", "evidence", "workspace_lock", "liveness", "liveness_note"],
      "properties": {
        "launch": {
          "type": "object",
          "required": ["launch_id", "workspace", "requested_at", "goal", "options", "phase", "run", "ended", "history", "process", "approval_required"],
          "properties": {
            "launch_id": { "type": "string" },
            "workspace": {
              "type": "object",
              "required": ["path", "identity"],
              "properties": { "path": { "type": "string" }, "identity": { "type": "string" } },
              "additionalProperties": true
            },
            "requested_at": { "type": "string" },
            "goal": {
              "type": "object",
              "required": ["sha256", "chars"],
              "properties": { "sha256": { "type": "string" }, "chars": { "type": "integer" } },
              "additionalProperties": true
            },
            "options": { "type": "object", "additionalProperties": true },
            "phase": { "type": "string", "enum": ["STARTING", "RUNNING", "ENDED"] },
            "run": {
              "type": ["object", "null"],
              "required": ["run_id", "started_at", "base_revision"],
              "properties": { "run_id": { "type": "string" }, "started_at": { "type": "string" }, "base_revision": { "type": ["string", "null"] } },
              "additionalProperties": true
            },
            "ended": {
              "type": ["object", "null"],
              "required": ["at", "exit_code", "workflow_status", "quality_gates_passed", "failure_category", "trace_run_id", "error", "note"],
              "properties": {
                "at": { "type": "string" },
                "exit_code": { "type": "integer" },
                "workflow_status": { "type": ["string", "null"] },
                "quality_gates_passed": { "type": ["boolean", "null"] },
                "failure_category": { "type": ["string", "null"] },
                "trace_run_id": { "type": ["string", "null"] },
                "error": { "type": ["string", "null"] },
                "note": { "type": "string" }
              },
              "additionalProperties": true
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["phase", "at"],
                "properties": { "phase": { "type": "string" }, "at": { "type": "string" } },
                "additionalProperties": true
              }
            },
            "process": { "type": ["object", "null"], "additionalProperties": true },
            "declined_decisions": {
              "type": "array",
              "description": "Decisions the run could proceed without (skill gap/conflict, live lookup) that the desktop declined: nothing was approved, the run continued; informational only.",
              "items": { "type": "object", "required": ["kind", "reason", "details", "noted_at"], "properties": { "kind": { "type": "string" }, "reason": { "type": "string" }, "details": { "type": "object", "additionalProperties": true }, "noted_at": { "type": "string" } }, "additionalProperties": true }
            },
            "pending_approval": {
              "type": ["object", "null"],
              "description": "The change review the run is waiting on (or last waited on): the exact candidate (digest; files with diff digests), Kriya's reviewer text VERBATIM (bounded) and its durable status. Only a PENDING review can be decided; Kriya's `launch-decision` action and the waiting process record the decision BEFORE the run continues.",
              "required": ["review_id", "sequence", "kind", "status", "requested_at", "expires_at", "candidate_digest", "files", "reason", "reason_truncated", "reason_sha256", "decision"],
