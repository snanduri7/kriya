{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kriya.local/kup/v1/evidence.schema.json",
  "title": "Attempt-evidence operations",
  "description": "evidence.manifest / evidence.verify / evidence.records payloads (Run Cockpit v1.1, capability set 1.1; handover/GUI-RUN-COCKPIT-V1_1/04 sections 4.1 - 4.3). Values the recorder wrote are carried verbatim and unknown fields are preserved; nothing is normalized or reconstructed.",
  "$defs": {
    "EvidenceAbsence": {
      "type": "object",
      "description": "DERIVED (never recorded) reason a run has no store on disk, from the run's recorded evidence.attempt_store event.",
      "required": [
        "reason",
        "derived_from",
        "detail"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "pruned",
            "capture_off",
            "recorder_unavailable",
            "pre_recorder",
            "unknown"
          ]
        },
        "derived_from": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_event": {
          "description": "The evidence.attempt_store event details exactly as stored; null when the event is absent or no snapshot was supplied."
        }
      },
      "additionalProperties": true
    },
    "EvidenceManifest": {
      "type": "object",
      "required": [
        "run_id",
        "store",
        "manifest",
        "seal",
        "line_count",
        "bytes_on_disk",
        "blob_file_count",
        "absence",
        "link"
      ],
      "properties": {
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The EVIDENCE run id. null when from_trace could not resolve one (the trace row records no store)."
        },
        "store": {
          "type": "string",
          "enum": [
            "present",
            "absent"
          ]
        },
        "manifest": {
          "type": [
            "object",
            "null"
          ],
          "description": "manifest.json verbatim: schema, writer_version, redaction_policy_version, capture, run_id and the run manifest keys.",
          "additionalProperties": true,
          "properties": {
            "schema": {
              "type": "string"
            },
            "writer_version": {
              "type": "string"
            },
            "redaction_policy_version": {
              "type": "string"
            },
            "capture": {
              "type": "string",
              "description": "A capture mode (full, digest_only, full_with_reasoning); a value outside capabilities.features.evidence_capture_modes is shown literally."
            }
          }
        },
        "seal": {
          "type": [
            "object",
            "null"
          ],
          "description": "seal.json verbatim; null when the store is unsealed. An unsealed store does not by itself prove a run is active.",
          "additionalProperties": true,
          "properties": {
            "final_seq": {
              "type": "integer"
            },
            "head_digest": {
              "type": "string"
            },
            "record_count": {
              "type": "integer"
            },
            "blob_count": {
              "type": "integer"
            },
            "complete": {
              "type": "boolean"
            },
            "gaps": {
              "type": "integer"
            },
            "degraded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "closed_reason": {
              "type": "string"
            }
          }
        },
        "line_count": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Complete record lines (a cheap count, not a verification)."
        },
        "bytes_on_disk": {
          "type": [
            "integer",
            "null"
          ]
        },
        "blob_file_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "absence": {
          "oneOf": [
            {
              "$ref": "#/$defs/EvidenceAbsence"
            },
            {
              "type": "null"
            }
          ]
        },
        "link": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "description": "from_trace only: how the evidence run id was resolved from the trace row's recorded evidence.attempt_store event (verbatim).",
              "required": [
                "trace_run_id",
                "evidence_run_id",
                "resolved_from",
                "recorded_event"
              ],
              "properties": {
                "trace_run_id": {
                  "type": "string"
                },
                "evidence_run_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "resolved_from": {
                  "type": "string"
                },
                "recorded_event": {
                  "description": "The event details exactly as stored."
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "EvidenceVerify": {
      "type": "object",
      "required": [
        "run_id",
        "status",
        "record_count",
        "sealed",
        "broken_seq",
        "detail",
        "seal",
        "blob_problems",
        "head_digest",
        "verified_at"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "UNSEALED",
            "NOT_FOUND",
            "CHAIN_BROKEN",
            "TRUNCATED_TAIL",
            "BLOB_CORRUPT",
            "SEAL_MISMATCH"
          ]
        },
        "record_count": {
          "type": "integer"
        },
        "sealed": {
          "type": "boolean"
        },
        "broken_seq": {
          "type": [
            "integer",
            "null"
          ]
        },
        "detail": {
          "type": "string"
        },
        "seal": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "blob_problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "head_digest": {
          "type": [
            "string",
            "null"
          ],
          "description": "Digest of the last complete record verified in this pass; null when the chain did not verify up to a head."
        },
        "verified_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "EvidenceRecord": {
      "type": "object",
      "description": "One record exactly as the recorder stored it (envelope keys in the evidence schema; unknown fields preserved) plus phase_provenance, which the reader computes and never stores.",
      "required": [
        "schema",
        "seq",
        "prev",
        "kind",
        "run_id",
        "provenance",
        "payload",
        "content_digests",
        "blobs",
        "phase_provenance"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "prev": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "unit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "invocation_seq": {
          "type": [
            "integer",
            "null"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt_number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "call_seq": {
          "type": [
            "integer",
            "null"
          ]
        },
        "wire_seq": {
          "type": [
            "integer",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "t_wall": {
          "type": "string"
        },
        "t_mono_ms": {
          "type": "integer"
        },
        "provenance": {
          "type": "string",
          "description": "OBSERVED, DERIVED, MODEL_CLAIMED, MIRRORED, NOT_RECORDED or LEGACY_RECONSTRUCTED (capabilities.features.evidence_provenances); an unknown value is shown literally."
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "content_digests": {
          "type": "object",
          "additionalProperties": true
        },
        "blobs": {
          "type": "object",
          "description": "Blob references (sha256:...) only; content is never inlined.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "phase_provenance": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "explicit",
            "derived_from_attempt_scope",
            "derived_from_role",
            null
          ],
          "description": "How the record's phase is known; everything but explicit is DERIVED. null: no phase was recorded, or it is an unmapped raw role name (nothing is synthesized)."
        }
      },
      "additionalProperties": true
    },
    "EvidenceRecords": {
      "type": "object",
      "required": [
        "run_id",
        "head_digest",
        "records",
        "next_cursor",
        "filters_applied",
        "truncated",
        "truncated_tail"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "head_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque; bound to the run, the filters and head_digest. null: no further matching record."
        },
        "filters_applied": {
          "type": "object",
          "additionalProperties": true
        },
        "truncated": {
          "type": "boolean",
          "description": "true: the page stopped at the response byte budget before the requested limit; next_cursor continues."
        },
        "truncated_tail": {
          "type": "boolean",
          "description": "true: an unsealed store ends in a partial record line, which is not served."
        }
      },
      "additionalProperties": true
    }
  }
}
