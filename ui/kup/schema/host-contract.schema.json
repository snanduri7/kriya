{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kriya.local/kup/v1/host-contract.schema.json",
  "title": "HostAdapter message contract",
  "description": "The typed allowlist of messages between the shared UI and ANY host (gate A-2 P-R2). A host (Electron preload, a browser test page, a future IDE plugin) implements exactly these; nothing else crosses the boundary. Requests are validated by the host before use (06 Phase E); responses are KUP envelopes or the typed results below.",
  "$defs": {
    "EditorId": {
      "type": "string",
      "enum": [
        "vscode",
        "intellij",
        "eclipse"
      ]
    },
    "SettingKey": {
      "type": "string",
      "enum": [
        "editor",
        "kriyaExecutable",
        "workspacePath",
        "configDirectory"
      ]
    },
    "KupRequest": {
      "description": "Exactly the gated grammar (03_GATE.md): history reads are PINNED to a snapshot id (required); acquisition is a separate explicit request; run_id, cursor and snapshot_id are opaque values the host validates before use.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "capabilities"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "snapshot.acquire"
            },
            "workspace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001F]*$",
              "description": "Absolute path without control characters."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "snapshot.list"
            },
            "verify": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "snapshot.prune"
            },
            "keep": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "snapshot_id"
          ],
          "properties": {
            "operation": {
              "const": "snapshot.verify"
            },
            "snapshot_id": {
              "$ref": "snapshot.schema.json#/$defs/SnapshotId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "snapshot_id"
          ],
          "properties": {
            "operation": {
              "const": "history.list"
            },
            "snapshot_id": {
              "$ref": "snapshot.schema.json#/$defs/SnapshotId"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9+/=_-]*$"
            },
            "workspace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001F]*$",
              "description": "Only the runs whose evidence manifest records this workspace (Kriya decides; the scope is reported in the result)."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "snapshot_id",
            "run_id"
          ],
          "properties": {
            "operation": {
              "const": "history.detail"
            },
            "snapshot_id": {
              "$ref": "snapshot.schema.json#/$defs/SnapshotId"
            },
            "run_id": {
              "$ref": "#/$defs/RunId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "snapshot_id",
            "run_id"
          ],
          "properties": {
            "operation": {
              "const": "history.prompt"
            },
            "snapshot_id": {
              "$ref": "snapshot.schema.json#/$defs/SnapshotId"
            },
            "run_id": {
              "$ref": "#/$defs/RunId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "workspace"
          ],
          "properties": {
            "operation": {
              "const": "workspace.status"
            },
            "workspace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001F]*$",
              "description": "Absolute path without control characters."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "workspace"
          ],
          "properties": {
            "operation": {
              "const": "workspace.describe"
            },
            "workspace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001F]*$",
              "description": "Absolute path without control characters."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "workspace"
          ],
          "properties": {
            "operation": {
              "const": "execution.preflight"
            },
            "workspace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001F]*$",
              "description": "Absolute path without control characters."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "parent", "name"],
          "properties": {
            "operation": { "const": "workspace.create" },
            "parent": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." },
            "name": { "type": "string", "minLength": 1, "maxLength": 100, "description": "ONE folder name (validated again by Kriya): no separator, no colon, no control character, no leading dot." }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "workspace"],
          "properties": { "operation": { "const": "configuration.approval_status" }, "workspace": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "workspace", "fingerprint"],
          "properties": { "operation": { "const": "configuration.approve" }, "workspace": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." }, "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "The review fingerprint Kriya gave with the status this person reviewed; Kriya approves only if the configuration it now resolves has the same fingerprint." } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "workspace"],
          "properties": { "operation": { "const": "execution.context" }, "workspace": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "workspace"],
          "properties": { "operation": { "const": "execution.model_probe" }, "workspace": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "workspace"],
          "properties": { "operation": { "const": "skills.list" }, "workspace": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "workspace", "skill_id"],
          "properties": { "operation": { "const": "skills.describe" }, "workspace": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." }, "skill_id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "description": "An item id (a skill name, or mcp:<server> / plugin:<name>). Never a path." } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "workspace"],
          "properties": { "operation": { "const": "tools.list" }, "workspace": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "workspace", "tool_id"],
          "properties": { "operation": { "const": "tools.describe" }, "workspace": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." }, "tool_id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "description": "An item id (a skill name, or mcp:<server> / plugin:<name>). Never a path." } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "workspace", "tool_id"],
          "properties": { "operation": { "const": "tools.approval_state" }, "workspace": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." }, "tool_id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "description": "An item id (a skill name, or mcp:<server> / plugin:<name>). Never a path." } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "workspace",
            "launch_id"
          ],
          "properties": {
            "operation": {
              "const": "launch.status"
            },
            "workspace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001F]*$",
              "description": "Absolute path without control characters."
            },
            "launch_id": {
              "type": "string",
              "pattern": "^[0-9]{8}T[0-9]{6}-[0-9a-f]{8}$",
              "description": "The shape of a Kriya run id; the launch id IS the run id."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "run_id"
          ],
          "properties": {
            "operation": {
              "const": "evidence.manifest"
            },
            "run_id": {
              "$ref": "#/$defs/RunId"
            },
            "snapshot_id": {
              "$ref": "snapshot.schema.json#/$defs/SnapshotId"
            },
            "from_trace": {
              "type": "boolean",
              "description": "run_id is a trace row id; needs snapshot_id."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "run_id"
          ],
          "properties": {
            "operation": {
              "const": "evidence.verify"
            },
            "run_id": {
              "$ref": "#/$defs/RunId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "run_id"
          ],
          "properties": {
            "operation": {
              "const": "evidence.records"
            },
            "run_id": {
              "$ref": "#/$defs/RunId"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001F]+$"
            },
            "phase": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001F]+$"
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001F]+$"
            },
            "attempt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "from_seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "kind": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z_]*(\\.[a-z_]+)*$"
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9+/=_-]*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "run_id",
            "seq",
            "part"
          ],
          "properties": {
            "operation": {
              "const": "evidence.change_content"
            },
            "run_id": {
              "$ref": "#/$defs/RunId"
            },
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "part": {
              "type": "string",
              "pattern": "^[a-z_]{1,32}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "run_id",
            "seq",
            "part"
          ],
          "properties": {
            "operation": {
              "const": "evidence.call_content"
            },
            "run_id": {
              "$ref": "#/$defs/RunId"
            },
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "part": {
              "type": "string",
              "pattern": "^[a-z_]{1,32}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "OpenInIdeRequest": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001F]+$",
          "description": "A path from recorded data (no control characters); the host opens it only if it is an existing regular file inside the selected workspace."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      },
      "additionalProperties": false
    },
    "OpenInIdeResult": {
      "type": "object",
      "required": [
        "ok",
        "editor",
        "verified",
        "message"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "editor": {
          "$ref": "#/$defs/EditorId"
        },
        "verified": {
          "type": "boolean",
          "description": "false = the host knows this editor's command form is unverified on this machine."
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "HostInfo": {
      "type": "object",
      "required": [
        "kind",
        "hostVersion",
        "fixtureMode",
        "configDirectory",
        "configDirectorySource",
        "configDirectoryProblem"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "hostVersion": {
          "type": "string"
        },
        "fixtureMode": {
          "type": "boolean",
          "description": "true while the host answers from fixtures (D-9)."
        },
        "configDirectory": {
          "type": [
            "string",
            "null"
          ],
          "description": "The validated directory every kriya child runs in (kriya.yaml discovery, SEC-009 classification); null when invalid. Independent of the recovery workspace (08 review F-5)."
        },
        "configDirectorySource": {
          "type": "string",
          "enum": [
            "setting",
            "default_home",
            "invalid"
          ]
        },
        "configDirectoryProblem": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the configuration directory is unusable (then every KUP call is a typed HOST_ERROR until it is fixed)."
        }
      },
      "additionalProperties": false
    },
    "SettingValue": {
      "type": [
        "string",
        "null"
      ]
    },
    "Messages": {
      "description": "The ten messages (six KUP-era plus the four workspace-lifecycle messages of M5). Each entry documents request and response shapes; the wire channel names are host-specific (Electron: kriya:kup:query etc.).",
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "request": {
              "$ref": "#/$defs/KupRequest"
            },
            "response": {
              "$ref": "common.schema.json#/$defs/Envelope"
            }
          }
        },
        "openInIde": {
          "type": "object",
          "properties": {
            "request": {
              "$ref": "#/$defs/OpenInIdeRequest"
            },
            "response": {
              "$ref": "#/$defs/OpenInIdeResult"
            }
          }
        },
        "copyToClipboard": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "maxLength": 8388608
            },
            "response": {
              "type": "null"
            }
          }
        },
        "getSetting": {
          "type": "object",
          "properties": {
            "request": {
              "$ref": "#/$defs/SettingKey"
            },
            "response": {
              "$ref": "#/$defs/SettingValue"
            }
          }
        },
        "setSetting": {
          "type": "object",
          "properties": {
            "request": {
              "type": "object",
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "$ref": "#/$defs/SettingKey"
                },
                "value": {
                  "$ref": "#/$defs/SettingValue"
                }
              },
              "additionalProperties": false
            },
            "response": {
              "type": "null"
            }
          }
        },
        "hostInfo": {
          "type": "object",
          "properties": {
            "request": {
              "type": "null"
            },
            "response": {
              "$ref": "#/$defs/HostInfo"
            }
          }
        },
        "chooseWorkspace": {
          "type": "object",
          "properties": {
            "request": {
              "type": "null"
            },
            "response": {
              "$ref": "#/$defs/WorkspaceChoice"
            }
          }
        },
        "recentWorkspaces": {
          "type": "object",
          "properties": {
            "request": {
              "type": "null"
            },
            "response": {
              "$ref": "#/$defs/RecentWorkspaces"
            }
          }
        },
        "rememberWorkspace": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001F]*$",
              "description": "Absolute path without control characters."
            },
            "response": {
              "$ref": "#/$defs/RecentWorkspaces"
            }
          }
        },
        "forgetWorkspace": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001F]*$",
              "description": "Absolute path without control characters."
            },
            "response": {
              "$ref": "#/$defs/RecentWorkspaces"
            }
          }
        },
        "startRun": {
          "type": "object",
          "properties": {
            "request": {
              "$ref": "#/$defs/StartRunRequest"
            },
            "response": {
              "$ref": "#/$defs/StartRunResult"
            }
          }
        },
        "executionState": {
          "type": "object",
          "properties": {
            "request": {
              "type": "null"
            },
            "response": {
              "$ref": "#/$defs/ExecutionState"
            }
          }
        },
        "decideApproval": {
          "type": "object",
          "properties": {
            "request": {
              "$ref": "#/$defs/DecideApprovalRequest"
            },
            "response": {
              "$ref": "#/$defs/DecideApprovalResult"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "WorkspaceChoice": {
      "description": "Result of the native folder chooser. The host returns a path only; Kriya (workspace.describe) interprets it.",
      "type": "object",
      "required": [
        "chosen",
        "path"
      ],
      "properties": {
        "chosen": {
          "type": "boolean",
          "description": "false when the person cancelled (a normal outcome: nothing changes)."
        },
        "path": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001F]*$",
              "description": "Absolute path without control characters."
            },
            {
              "type": "null"
            }
          ]
        },
        "refused": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "RUN_ACTIVE"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "RUN_ACTIVE: the workspace cannot change while a run this host started is in progress."
        }
      },
      "additionalProperties": false
    },
    "RecentWorkspaces": {
      "description": "A bounded, most-recent-first list of folders previously opened. Remembered paths are NOT trusted: opening one runs the same Kriya validation.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^/[^\\u0000-\\u001F]*$",
        "description": "Absolute path without control characters."
      }
    },
    "StartRunRequest": {
      "description": "Start Run (GUI M6): the ONLY execution action. The workspace must be the folder currently open in this host (chosen with Open Folder); the goal is the engineering task. There are no other options: a launch is non-interactive and cannot widen Kriya's configuration or authority.",
      "type": "object",
      "required": [
        "workspace",
        "goal"
      ],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000-\\u001F]*$",
          "description": "Absolute path without control characters."
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        }
      },
      "additionalProperties": false
    },
    "StartRunResult": {
      "description": "Answer to Start Run. started=true means a Kriya process was launched and a launch id exists (follow it with launch.status); the outcome of the run is only ever in Kriya's durable records. started=false carries Kriya's or the host's typed refusal.",
      "type": "object",
      "required": [
        "started",
        "launch_id",
        "refusal"
      ],
      "properties": {
        "started": {
          "type": "boolean"
        },
        "launch_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{8}T[0-9]{6}-[0-9a-f]{8}$",
              "description": "The shape of a Kriya run id; the launch id IS the run id."
            },
            {
              "type": "null"
            }
          ]
        },
        "refusal": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "blockers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "code",
                      "message"
                    ],
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ExecutionState": {
      "description": "What the HOST knows about the one execution process it started: the process, not the run. It never carries an outcome - Kriya's durable records (launch.status, the trace row, the evidence store) are the outcome. No stdout/stderr text is passed on.",
      "type": "object",
      "required": [
        "phase",
        "launch_id",
        "workspace",
        "started_at",
        "ended_at",
        "exit",
        "diagnostic"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "idle",
            "starting",
            "running",
            "exited"
          ]
        },
        "launch_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{8}T[0-9]{6}-[0-9a-f]{8}$",
              "description": "The shape of a Kriya run id; the launch id IS the run id."
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001F]*$",
              "description": "Absolute path without control characters."
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "code",
                "signal"
              ],
              "properties": {
                "code": {
                  "oneOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "signal": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "spawn_failed",
                "terminated_by_the_host"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "A typed host-side reason; never process output."
        }
      },
      "additionalProperties": false
    },
    "DecideApprovalRequest": {
      "description": "Review decision (GUI final): ONE human decision for the change review that is pending in a launch Kriya recorded. It carries the identities Kriya gave the pending review (launch id, review id, candidate digest) and nothing else - no option can approve 'whatever is current', approve always, or widen Kriya's authority. Kriya (`launch-decision`) validates every identity against its durable state and refuses a stale, replayed, foreign or late request.",
      "type": "object",
      "required": [
        "workspace",
        "launch_id",
        "review_id",
        "candidate_digest",
        "decision"
      ],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000-\\u001F]*$",
          "description": "Absolute path without control characters."
        },
        "launch_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}-[0-9a-f]{8}$"
        },
        "review_id": {
          "type": "string",
          "pattern": "^ra-[0-9a-f]{24}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject"
          ]
        }
      },
      "additionalProperties": false
    },
    "DecideApprovalResult": {
      "description": "Answer to a review decision. accepted=true means Kriya durably recorded the decision for the waiting run; the run's outcome is only ever in Kriya's durable records. accepted=false carries Kriya's or the host's closed refusal code.",
      "type": "object",
      "required": [
        "accepted",
        "code",
        "message"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "launch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ApproveConfigurationRequest": {
      "description": "Approve the configuration the person reviewed. Exactly these two fields: the folder (which must be the one the host has open) and the review fingerprint Kriya gave with configuration.approval_status. There is no field for settings, values, a path, a digest to trust or a store location.",
      "type": "object",
      "required": ["workspace", "fingerprint"],
      "properties": { "workspace": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001F]*$", "description": "Absolute path without control characters." }, "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "The review fingerprint Kriya gave with the status this person reviewed; Kriya approves only if the configuration it now resolves has the same fingerprint." } },
      "additionalProperties": false
    },
    "ApproveConfigurationResult": {
      "description": "Kriya's answer to an approval request, passed through. approved=true means Kriya wrote (or found already current) the approval for exactly the reviewed configuration. approved=false with outcome 'declined' (and no code) means the person pressed Cancel in the host's native confirmation: a normal decision, Kriya was not asked and nothing was written. Otherwise approved=false carries a closed code: APPROVAL_STALE (the configuration changed after it was reviewed; nothing was approved), APPROVAL_UNAVAILABLE, or a host refusal such as WORKSPACE_NOT_OPEN, INVALID_REQUEST, RUN_ACTIVE, APPROVAL_IN_FLIGHT.",
      "type": "object",
      "required": ["approved", "outcome", "code", "message", "reason"],
      "properties": {
        "approved": { "type": "boolean" }, "outcome": { "type": ["string", "null"] }, "code": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] }, "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
