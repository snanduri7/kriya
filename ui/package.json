{
  "name": "kriya-ui",
  "private": true,
  "version": "0.0.1",
  "description": "Kriya run inspector UI (M1). Host-independent panels in shared/, KUP contract in kup/, a plain-browser test host and an Electron standalone shell. Nothing here is imported by kriya/.",
  "workspaces": [
    "kup",
    "shared",
    "test-host",
    "standalone"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:shared-deps": "node scripts/check-shared-deps.mjs",
    "check": "npm run fixtures && npm run check:generated -w @kriya-ui/kup && npm run typecheck && npm run lint && npm run check:shared-deps && npm run test:scripts && npm run test && npm run java:check -w @kriya-ui/kup",
    "fixtures": "node fixtures/generate.mjs",
    "fixtures:serializer": "node scripts/serializer-fixtures.mjs",
    "fixtures:serializer:check": "node scripts/serializer-fixtures.mjs --check",
    "check:integration": "npm run check && npm run fixtures:serializer:check",
    "build": "npm run build --workspaces --if-present",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
