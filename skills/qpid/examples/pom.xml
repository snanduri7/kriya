<!--
  THIS SHAPE IS ONLY FOR WHEN JVM STARTUP FLAGS ARE ACTUALLY NEEDED - which includes any
  Qpid app that EMBEDS the broker via SystemLauncher.startup() (needs at minimum
  -Djava.security.manager=allow on Java 17.0.10+, or SystemLauncher's own internal startup
  logging crashes with "UnsupportedOperationException: getSubject is not supported" -
  confirmed live, unrelated to anything the generated app code does), not just Ignite. A
  Qpid app that's ONLY a client connecting to an already-running EXTERNAL broker (no
  SystemLauncher call anywhere) genuinely needs no JVM flags - use the much simpler plain
  form instead, invoked via exec:java (not exec:exec), even if nothing below mentions it:
    <configuration>
      <mainClass>${exec.mainClass}</mainClass>
    </configuration>
  run via `mvn -q compile exec:java -Dexec.mainClass=...`. Confirmed live: combining THIS
  file's <executable>/<arguments>/<classpath/> shape with an exec:java invocation instead
  of exec:exec crashes immediately with "Cannot store value into array ... element type
  mismatch" - exec:java binds "arguments" to the target class's own main(String[] args),
  not Maven launch flags, and <classpath/> is not a plain string, so it can never go there.
  The two shapes must never be mixed.

  exec-maven-plugin 3.1.0's "java" goal (exec:java) has NO "jvmArguments" parameter at
  all - confirmed by reading the actual mojo descriptor from the jar. It also runs inside
  Maven's own already-started JVM, so it cannot apply module-opening flags even in
  principle (JVM startup flags can only be set at startup). Use exec:exec instead: it
  spawns a genuinely new `java` process via <executable>java</executable>, with every
  add-opens flag as its own <argument>, followed by <argument>-classpath</argument> and the bare,
  self-closing <classpath/> element (exec-maven-plugin's own placeholder for the resolved
  project classpath - not wrapped in <argument>), followed by the main class as the final
  argument. Run via `mvn -q compile exec:exec -Dexec.mainClass=...`, not exec:java.

  The final argument MUST be ${exec.mainClass}, never a hardcoded literal class name -
  confirmed live: a literal argument value ignores `-Dexec.mainClass=...` on the command
  line and always runs that class regardless. Set a sensible default in <properties>, e.g.
  <exec.mainClass>com.example.CombinedBrokerClientApp</exec.mainClass>, so `mvn exec:exec`
  with no override still does something reasonable, and so any other class in the same
  project (e.g. a standalone broker-only entrypoint) stays independently runnable via
  `-Dexec.mainClass=com.example.OtherClass`.
-->
<plugin>
  <groupId>org.codehaus.mojo</groupId>
  <artifactId>exec-maven-plugin</artifactId>
  <version>3.1.0</version>
  <configuration>
    <executable>java</executable>
    <arguments>
      <!-- Required whenever the app embeds the broker (SystemLauncher.startup()) - see the
           -Djava.security.manager=allow rule above. Add --add-opens flags too if the app
           also embeds Ignite or another JVM-17-reflection-heavy library in the same class. -->
      <argument>-Djava.security.manager=allow</argument>
      <argument>-classpath</argument>
      <classpath/>
      <argument>${exec.mainClass}</argument>
    </arguments>
  </configuration>
</plugin>
