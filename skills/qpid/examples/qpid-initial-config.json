{
  "name": "broker",
  "modelVersion": "8.0",
  "ports": [
    {
      "name": "AMQP",
      "port": 5672,
      "virtualhostaliases": [
        {
          "type": "defaultAlias"
        }
      ]
    }
  ],
  "virtualhosts": [
    {
      "name": "default",
      "nodeAutoCreationPolicies": [
        {
          "pattern": ".*",
          "createdOnPublish": true,
          "createdOnConsume": true,
          "nodeType": "queue"
        }
      ]
    }
  ]
}