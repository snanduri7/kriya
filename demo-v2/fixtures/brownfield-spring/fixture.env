# Identity of the brownfield fixture used by scenario 01. The fixture itself is NOT in git (see README.md): it is a snapshot
# of a third-party public project with local additions, and no license was verified, so it is materialised at prep time and
# checked against this identity. Sourced by scripts/*.sh and parsed by tests/test_demo_v2_assets.py: KEY=VALUE only.
FIXTURE_ID=brownfield-spring-boot-driver
# Where the snapshot is taken from when DEMO_V2_BASELINE_SRC is not set. A local git repository (the A4 validation baseline).
FIXTURE_SOURCE_DEFAULT=$HOME/kriya-live-validation/graphify-poc/spring-boot-application-example
FIXTURE_COMMIT=0d7a09136cfec085156308d706d53b091ecd3cde
FIXTURE_TARGET_FILE=src/main/java/com/myapp/service/driver/DefaultDriverService.java
FIXTURE_TARGET_SHA256=a15b6ba2c20bafafeea108b073adb1824bb538cc456dfd78400b8e79122944bb
# Baseline measured by the previous demo's qualification (53 tests, 0 failures). Re-measured by prepare_demo.sh --check-build.
FIXTURE_BASELINE_TESTS=53
# The bug: delete(Long) sets the deleted flag but never persists it. The check is scoped to that ONE method body (the same
# file's create() already calls save), and accepts either repository persistence call: it checks the outcome, not the wording.
FIXTURE_METHOD_START_REGEX=public void delete\(Long driverId\)
FIXTURE_FIX_REGEX=\.(save|saveAndFlush)\(
FIXTURE_UPSTREAM=https://github.com/alexmanrique/spring-boot-application-example
FIXTURE_LICENSE=UNVERIFIED
