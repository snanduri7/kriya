# Identity of the scenario 04 fixtures. Both are self-authored or repository-owned, so they ARE in git. Neither is ever placed in the scenario workspace.
FIXTURE_ID=spring-ignite-protocol
# The MODEL-FREE REFERENCE CANDIDATE: a deterministic, hand-assembled implementation of the scenario goal built ONLY from historically evidenced pieces (see handover/SPRING-IGNITE-PROTOCOL/QUALIFICATION.md).
# It exists to prove the environment (Java, Maven offline, Spring XML, Ignite 2.18.0, JUnit, Protocol/ProtocolParser, cache put/get, clean exit). It is NOT the live demo output and is never copied into the workspace.
REFERENCE_DIR=fixtures/spring-ignite-protocol/reference
REFERENCE_DIGEST=626d5510cb0d83e75c15a673c0176c8f6d71518931b98c8f26ec853f1b6ad204
REFERENCE_FILES=11
REFERENCE_TEST_COUNT=5
REFERENCE_MAIN_CLASS=com.example.Main
# The application-owned success line the reference (and a correct live candidate) prints, for the sample values in the scenario goal.
EXPECTED_RESULT_LINE=[RESULT] protocolVersion=1, softwareVersion=2, dataLength=15, time=1700000000, bodyLength=15, equals=true
# The knowledge the scenario supplies: the verified skill that ships in the repository. The scenario copies it into the work area (cp -R) and checks this digest, so a run's own write never reaches the repository copy.
SKILL_NAME=ignite-java17
SKILL_SOURCE_DIR=skills/ignite-java17
SKILL_DIGEST=7646529d0cd8e3df05951dbf41a86a71c02556ddf924b8093b2c07a34446e0b0
SKILL_FILES=5
# The scenario's calibrated run-wide generation budget (seconds): the ONE expected value. The scenario template must equal it (tests/test_demo_v2_spring_ignite.py) and verify_demo.sh --scenario 04 compares the rendered configuration
# against it (tests/test_demo_v2_verify_budget_pin_001.py); neither carries its own literal. MEASURED calibration history (handover/PRODUCT-72H/SPRINT_LOG.md 12m/12n): 900 s stopped Run 1 at unit s4, 1500 s stopped Run 2 at the
# s6 consumer retry (1354 s active), so the owner set 2400 s for the final run. The verification standards are not affected by this value.
EXPECTED_GENERATION_BUDGET_SECONDS=2400
